#!/bin/sh

set -e

. /etc/default/openmediavault
. /usr/share/openmediavault/scripts/helper-functions

case "$1" in
    configure)
        # Ensure our wrapper scripts are executable if they exist
        for script in /usr/sbin/vcm.sh /usr/sbin/vcd.sh /usr/sbin/vcu.sh /usr/sbin/vci.sh; do
            if [ -f "$script" ]; then
                chmod +x "$script"
            fi
        done

        # Ensure our confdb create script is executable
        if [ -f "/usr/share/openmediavault/confdb/create.d/conf.service.veracrypt.sh" ]; then
            chmod +x /usr/share/openmediavault/confdb/create.d/conf.service.veracrypt.sh
        fi

        # Initialize config database node for VeraCrypt
        echo "Updating configuration database ..."
        omv-confdbadm create "conf.service.veracrypt" || :

        # Restart openmediavault-engined so it registers the new RPC classes immediately
        if [ -x "/bin/systemctl" ]; then
            systemctl stop openmediavault-engined.service || true
            pkill -f omv-engined || true
            systemctl start openmediavault-engined.service || true
        fi

        # Activate package triggers to compile and render Angular Web UI workbench manifests
        echo "Updating Web UI workbench cache ..."
        dpkg-trigger update-workbench
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument" >&2
        exit 1
        ;;
esac

exit 0
